# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# Port the Express server listens on (Vite proxies /api to this port in dev)
PORT=3000

# development | production  (`npm start` sets production automatically)
NODE_ENV=development

# Pipedream (or any HTTPS) webhook that receives registration submissions.
# Kept server-side so it is never exposed in the browser bundle.
# If empty: dev mode simulates a successful submission, production returns 503.
PIPEDREAM_WEBHOOK_URL=

# Max registration submissions per IP per 15 minutes
RATE_LIMIT_MAX=10

# Set to 1 when running behind a reverse proxy / load balancer
# (Render, Railway, Fly, Nginx, Cloudflare...) so rate limiting sees real client IPs
TRUST_PROXY=0
